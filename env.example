# Copy to .env and chmod 600 .env. Replace every placeholder. Never commit .env.
# This file is loaded by docker-compose.example.yml.

# --- HTTP MCP transport (required unless MCP_EMAIL_HTTP_INSECURE=true) ---
MCP_HOST=0.0.0.0
MCP_PORT=9557
# Comma-separated Host values the MCP client will send. Wildcard bind (0.0.0.0)
# plus this explicit list is the Tailscale/WireGuard setup. Include the MagicDNS
# name, the tailnet IP, and the LAN IP:port the client uses. Loopback is always
# unioned in so the container healthcheck (Host: 127.0.0.1) keeps working.
MCP_ALLOWED_HOSTS=nas.tail-xxxx.ts.net,100.64.1.10,192.168.1.50:9557
MCP_ALLOWED_ORIGINS=
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_EMAIL_HTTP_BEARER_TOKEN=replace-with-a-long-random-token
# Optional rotation list (comma-separated). Either this or the single token.
# MCP_EMAIL_HTTP_BEARER_TOKENS=current-token,previous-token
# MCP_EMAIL_HTTP_BEARER_TOKEN_FILE=/run/secrets/mcp_http_token
MCP_EMAIL_HTTP_INSECURE=false

# --- Encrypted local cache (optional; leave unset to disable) ---
MCP_EMAIL_CACHE_KEY=replace-with-a-long-random-passphrase
# MCP_EMAIL_CACHE_KEY_FILE=/run/secrets/mcp_cache_key
MCP_EMAIL_CACHE_DIR=/data/cache
MCP_EMAIL_CACHE_MAX_BYTES=67108864
MCP_EMAIL_CACHE_MAX_AGE_SECONDS=604800

# --- Connection reuse (recommended on a NAS) ---
MCP_EMAIL_SERVER_IMAP_POOL=true
MCP_EMAIL_SERVER_SMTP_POOL=false
MCP_EMAIL_SERVER_POOL_IDLE_SECONDS=60

# --- Outgoing attachment allowlist ---
MCP_EMAIL_SERVER_ATTACHMENT_DIR=/data/attachments

# After send_draft succeeds: safe (default) deletes the draft only when a Sent
# copy was saved; delete / move / keep override that.
# MCP_EMAIL_SERVER_SEND_DRAFT=safe

# Full Python tracebacks on IMAP/SMTP failures (can leak passwords in locals).
# MCP_EMAIL_SERVER_LOG_TRACEBACKS=false

# --- Recipient allowlist (empty denies all sending; "*" allows everyone) ---
MCP_EMAIL_SERVER_ALLOWED_RECIPIENTS=alice@example.com,family@example.com

# --- Tool catalog ---
# MCP_EMAIL_SERVER_TOOL_ALLOW=list_available_accounts,list_emails_metadata,get_emails_content,send_email,reply_email,forward_email,save_draft,send_draft
MCP_EMAIL_SERVER_TOOL_DENY=list_email_tags,set_email_tags,download_attachment

# --- Multi-account env (no V2 admin UI required) ---
MCP_EMAIL_SERVER_ACCOUNTS=netease,aliyun,icloud

MCP_EMAIL_SERVER_ACCOUNT_netease_EMAIL_ADDRESS=you@163.com
MCP_EMAIL_SERVER_ACCOUNT_netease_PASSWORD=sixteen-char-auth
MCP_EMAIL_SERVER_ACCOUNT_netease_PRESET=163

MCP_EMAIL_SERVER_ACCOUNT_aliyun_EMAIL_ADDRESS=you@company.example
MCP_EMAIL_SERVER_ACCOUNT_aliyun_PASSWORD=replace-me
MCP_EMAIL_SERVER_ACCOUNT_aliyun_PRESET=aliyun

MCP_EMAIL_SERVER_ACCOUNT_icloud_EMAIL_ADDRESS=you@icloud.com
MCP_EMAIL_SERVER_ACCOUNT_icloud_PASSWORD=app-specific-password
MCP_EMAIL_SERVER_ACCOUNT_icloud_PRESET=icloud

# Optional later: Tsinghua Coremail
# MCP_EMAIL_SERVER_ACCOUNT_thu_EMAIL_ADDRESS=you@mails.tsinghua.edu.cn
# MCP_EMAIL_SERVER_ACCOUNT_thu_PASSWORD=replace-me
# MCP_EMAIL_SERVER_ACCOUNT_thu_PRESET=tsinghua
