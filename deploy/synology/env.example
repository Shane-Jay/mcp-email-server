# Copy to .env next to docker-compose.yml and chmod 600 .env.
# Replace every placeholder. Never commit .env or files under secrets/.

# Host IP that publishes container port 9557. Use the NAS Tailscale
# address (100.x), not 0.0.0.0. Compose interpolates this for ports:.
MCP_BIND_IP=100.64.0.1

# Synology shared-folder paths. chown -R 1000:1000 these directories.
MCP_DATA_DIR=/volume1/docker/mcp-email-server/data
MCP_CACHE_DIR=/volume1/docker/mcp-email-server/cache
MCP_ATTACHMENT_DIR=/volume1/docker/mcp-email-server/attachments
MCP_SECRETS_DIR=./secrets

# --- HTTP MCP transport ---
MCP_HOST=0.0.0.0
MCP_PORT=9557
# Host values the MCP client will send. Include MagicDNS and the tailnet IP.
# Loopback is always unioned so the container healthcheck keeps working.
MCP_ALLOWED_HOSTS=nas.tail-xxxx.ts.net,100.64.0.1
MCP_ALLOWED_ORIGINS=
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
# Token lives in the Docker secret file, not in this env file.
# MCP_EMAIL_HTTP_BEARER_TOKEN_FILE is set in docker-compose.yml.
MCP_EMAIL_HTTP_INSECURE=false

# --- Encrypted local cache ---
# Key lives in the Docker secret file (MCP_EMAIL_CACHE_KEY_FILE).
MCP_EMAIL_CACHE_DIR=/data/cache
MCP_EMAIL_CACHE_MAX_BYTES=67108864
MCP_EMAIL_CACHE_MAX_AGE_SECONDS=604800

# --- Connection reuse ---
MCP_EMAIL_SERVER_IMAP_POOL=true
MCP_EMAIL_SERVER_SMTP_POOL=false
MCP_EMAIL_SERVER_POOL_IDLE_SECONDS=60

# --- Outgoing attachments (host dir is bind-mounted) ---
MCP_EMAIL_SERVER_ATTACHMENT_DIR=/data/attachments

# After send_draft succeeds: delete the draft only when a Sent copy was saved.
MCP_EMAIL_SERVER_SEND_DRAFT=safe

# --- Recipient allowlist (empty denies all sending; "*" allows everyone) ---
MCP_EMAIL_SERVER_ALLOWED_RECIPIENTS=you@163.com,you@company.example,you@icloud.com

# Conservative catalog: read, send, reply, forward, drafts, mailbox list.
# Excludes email_command, delete/move/archive, flags/tags, attachment download.
MCP_EMAIL_SERVER_TOOL_ALLOW=list_available_accounts,list_emails_metadata,get_emails_content,send_email,reply_email,forward_email,save_draft,send_draft,list_mailboxes

# --- Three accounts (presets fill hosts; passwords are Docker secrets) ---
MCP_EMAIL_SERVER_ACCOUNTS=netease,aliyun,icloud

MCP_EMAIL_SERVER_ACCOUNT_netease_EMAIL_ADDRESS=you@163.com
MCP_EMAIL_SERVER_ACCOUNT_netease_PRESET=163
# MCP_EMAIL_SERVER_ACCOUNT_netease_PASSWORD_FILE=/run/secrets/netease_auth_code

MCP_EMAIL_SERVER_ACCOUNT_aliyun_EMAIL_ADDRESS=you@company.example
MCP_EMAIL_SERVER_ACCOUNT_aliyun_PRESET=aliyun
# MCP_EMAIL_SERVER_ACCOUNT_aliyun_PASSWORD_FILE=/run/secrets/aliyun_auth_code

MCP_EMAIL_SERVER_ACCOUNT_icloud_EMAIL_ADDRESS=you@icloud.com
MCP_EMAIL_SERVER_ACCOUNT_icloud_PRESET=icloud
# MCP_EMAIL_SERVER_ACCOUNT_icloud_PASSWORD_FILE=/run/secrets/icloud_app_password
