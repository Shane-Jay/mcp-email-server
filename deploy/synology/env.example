# Copy to .env next to docker-compose.yml and chmod 600 .env.
# Replace every placeholder. Never commit .env or files under secrets/.

# Access mode. Compose interpolates MCP_BIND_IP; it cannot derive it from
# MCP_ACCESS_MODE. Set both to the matching pair:
#
#   lan (default) — LAN devices and WireGuard-routed home subnets
#     MCP_ACCESS_MODE=lan
#     MCP_BIND_IP=0.0.0.0
#     MCP_ALLOWED_HOSTS=<NAS-LAN-IP>:9557,<NAS-hostname>:9557
#
#   local — NAS loopback only (this machine, or a reverse proxy on the NAS)
#     MCP_ACCESS_MODE=local
#     MCP_BIND_IP=127.0.0.1
#     MCP_ALLOWED_HOSTS=127.0.0.1:9557,localhost:9557
MCP_ACCESS_MODE=lan
MCP_BIND_IP=0.0.0.0

# Synology shared-folder paths. chown 1000:1000 the data and attachment
# directories only (container uid 1000 must be able to write).
# Secret files stay owned by your DSM user, group users (gid 100), mode 640;
# the secrets directory is 750. See README.md in this folder.
# Do not mount a mail cache. The encrypted cache is unused by the live read path.
MCP_DATA_DIR=/volume1/docker/mcp-email-server/data
MCP_ATTACHMENT_DIR=/volume1/docker/mcp-email-server/attachments
MCP_SECRETS_DIR=./secrets

# --- HTTP MCP transport ---
MCP_HOST=0.0.0.0
MCP_PORT=9557
# Host values the MCP client will send. Loopback is always unioned so the
# container healthcheck keeps working. DNS-rebinding protection stays on.
# Example LAN IP and mDNS name only — replace with this NAS.
MCP_ALLOWED_HOSTS=192.168.1.50:9557,nas.local:9557
MCP_ALLOWED_ORIGINS=
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
# Token lives in the Docker secret file, not in this env file.
# MCP_EMAIL_HTTP_BEARER_TOKEN_FILE is set in docker-compose.yml.
MCP_EMAIL_HTTP_INSECURE=false

# The encrypted mail cache is unused by the live MCP read path. Do not set
# MCP_EMAIL_CACHE_KEY or MCP_EMAIL_CACHE_KEY_FILE.

# --- Connection reuse ---
MCP_EMAIL_SERVER_IMAP_POOL=true
MCP_EMAIL_SERVER_SMTP_POOL=false
MCP_EMAIL_SERVER_POOL_IDLE_SECONDS=60

# --- Outgoing attachments (host dir is bind-mounted) ---
MCP_EMAIL_SERVER_ATTACHMENT_DIR=/data/attachments

# After send_draft succeeds: delete the draft only when a Sent copy was saved.
MCP_EMAIL_SERVER_SEND_DRAFT=safe

# --- Recipient allowlist (empty denies all sending; "*" allows everyone) ---
MCP_EMAIL_SERVER_ALLOWED_RECIPIENTS=you@163.com,you@company.example,you@icloud.com

# Conservative catalog: read, send, reply, forward, drafts, mailbox list.
# Excludes email_command, delete/move/archive, flags/tags, attachment download.
MCP_EMAIL_SERVER_TOOL_ALLOW=list_available_accounts,list_emails_metadata,get_emails_content,send_email,reply_email,forward_email,save_draft,send_draft,list_mailboxes
# Remote clients that drop embedded resources should use read_attachment and
# attachments_inline instead of download_attachment / get_attachment_content.
# After you have verified both, you may leave ENABLE_ATTACHMENT_DOWNLOAD unset
# and remove download_attachment and get_attachment_content from TOOL_ALLOW.
# Add read_attachment to TOOL_ALLOW, then set:
# MCP_EMAIL_SERVER_ENABLE_ATTACHMENT_READ=true
# MCP_EMAIL_SERVER_ENABLE_INLINE_ATTACHMENTS=true
# enable_attachment_content=true also turns on read_attachment.
# get_attachment_content still needs MCP_EMAIL_SERVER_ENABLE_ATTACHMENT_CONTENT=true
# AND the tool name in TOOL_ALLOW. Either flag alone is not enough.

# --- Three accounts (presets fill hosts; passwords are Docker secrets) ---
MCP_EMAIL_SERVER_ACCOUNTS=netease,aliyun,icloud

MCP_EMAIL_SERVER_ACCOUNT_netease_EMAIL_ADDRESS=you@163.com
MCP_EMAIL_SERVER_ACCOUNT_netease_PRESET=163
# MCP_EMAIL_SERVER_ACCOUNT_netease_PASSWORD_FILE=/run/secrets/netease_auth_code

MCP_EMAIL_SERVER_ACCOUNT_aliyun_EMAIL_ADDRESS=you@company.example
MCP_EMAIL_SERVER_ACCOUNT_aliyun_PRESET=aliyun
# MCP_EMAIL_SERVER_ACCOUNT_aliyun_PASSWORD_FILE=/run/secrets/aliyun_auth_code

MCP_EMAIL_SERVER_ACCOUNT_icloud_EMAIL_ADDRESS=you@icloud.com
MCP_EMAIL_SERVER_ACCOUNT_icloud_PRESET=icloud
# MCP_EMAIL_SERVER_ACCOUNT_icloud_PASSWORD_FILE=/run/secrets/icloud_app_password
